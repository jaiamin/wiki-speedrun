# Sent on every request to Wikimedia. Set this to something that identifies
# your deployment and gives them a way to contact you — it is required by
# Wikimedia's User-Agent policy, and anonymous agents get rate limited.
# https://foundation.wikimedia.org/wiki/Policy:Wikimedia_Foundation_User-Agent_Policy
WIKI_USER_AGENT="wiki-speedrun/0.1 (https://github.com/you/wiki-speedrun; you@example.com)"

# Wikipedia language edition. Other editions work, but the bundled article
# pools in src/data/pools.json are English — regenerate them with `npm run
# pools` if you change this.
NEXT_PUBLIC_WIKI_LANG="en"
